---
import Icon from './Icon.astro';
import { route } from '../lib/routes';
import { t } from '../lib/utils';

const { site, ui, lang, routeKey, routeId, alternateHref } = Astro.props;
const nav = [
  { key: 'publications', label: 'publications' },
  { key: 'teaching', label: 'teaching' },
  { key: 'projects', label: 'projects' },
  { key: 'background', label: 'nav_background' },
  { key: 'outreach', label: 'nav_outreach' },
  { key: 'contact', label: 'contact' },
];
const activeKey = routeKey === 'publication' || routeKey === 'conference' ? 'publications' : routeKey;
const esHref = lang === 'es' ? route('es', routeKey, routeId) : alternateHref;
const enHref = lang === 'en' ? route('en', routeKey, routeId) : alternateHref;
---
<header class="site-header">
  <div class="container header-bar">
    <a class="wordmark" href={route(lang, 'home')} aria-current={routeKey === 'home' ? 'page' : undefined}>
      <svg class="wordmark-mark" viewBox="0 0 26 18" width="26" height="18" aria-hidden="true" focusable="false">
        <polyline points="1,13 8,5 14,10 25,2" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
        <circle cx="8" cy="5" r="2.4" />
        <circle cx="14" cy="10" r="2.4" />
      </svg>
      <span>{site.name}</span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label={t(ui, 'main_navigation')}>
      <ul>
        {nav.map((item) => (
          <li><a href={route(lang, item.key)} aria-current={activeKey === item.key ? 'page' : undefined}>{t(ui, item.label)}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-tools">
      <div class="lang-switch" role="group" aria-label={t(ui, 'lang_label')}>
        <a href={esHref} hreflang="es" lang="es" aria-current={lang === 'es' ? 'true' : undefined} data-lang-switch>ES</a>
        <a href={enHref} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined} data-lang-switch>EN</a>
      </div>
      <button class="icon-button theme-toggle" type="button" aria-label={t(ui, 'theme_toggle')} title={t(ui, 'theme_toggle')}>
        <Icon name="moon" class="when-light" />
        <Icon name="sun" class="when-dark" />
      </button>
      <button class="icon-button menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={t(ui, 'mobile_nav')}>
        <Icon name="menu" class="when-closed" size={20} />
        <Icon name="close" class="when-open" size={20} />
      </button>
    </div>
  </div>
</header>
