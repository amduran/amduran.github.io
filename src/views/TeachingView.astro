---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { getUi, collectionData } from '../lib/content';
import { t, fmt, byIdxDesc, authorsHtml, shortAcademicYear, formatMoney, formatNumber, stripHtml } from '../lib/utils';

const { lang } = Astro.props;
const ui = await getUi(lang);
const teaching = await collectionData('teaching');
const directed = await collectionData('directed_projects');
const innovation = await collectionData('teaching_innovation_projects');
const current = teaching.filter((x) => Number(x.current) === 1).sort(byIdxDesc);
const past = teaching.filter((x) => Number(x.current) !== 1).sort(byIdxDesc);
const currentYear = current[0]?.academic_year || '';

// Past courses grouped by academic year, newest first.
const groups = [];
for (const row of past) {
  const last = groups[groups.length - 1];
  if (last && last.year === row.academic_year) last.rows.push(row);
  else groups.push({ year: row.academic_year, rows: [row] });
}
groups.sort((a, b) => String(b.year).localeCompare(String(a.year)));
const isSoleSupervisor = (value) => !/\s(y|and)\s|,/.test(stripHtml(value));
---
<BaseLayout lang={lang} routeKey="teaching" title={t(ui, 'teaching_page_title')} description={t(ui, 'teaching_page_desc')}>
  <PageIntro title={t(ui, 'teaching_page_title')} description={t(ui, 'teaching_page_desc')} />

  <section class="container page-section" aria-labelledby="current-heading">
    <header class="section-head">
      <h2 id="current-heading">{t(ui, 'current_courses')}</h2>
      {currentYear && <p class="section-note">{fmt(t(ui, 'this_year'), { year: currentYear })}</p>}
    </header>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr><th scope="col">{t(ui, 'subject')}</th><th scope="col">{t(ui, 'degree')}</th><th scope="col">{t(ui, 'institution')}</th><th scope="col">{t(ui, 'role')}</th><th scope="col" class="num">{t(ui, 'hours')}</th></tr>
        </thead>
        <tbody>
          {current.map((row) => (
            <tr>
              <th scope="row">{row.subject}</th>
              <td>{row.degree.trim()} <span class="muted">({fmt(t(ui, 'course_year'), { n: row.course })})</span></td>
              <td>{row.entity}</td>
              <td>{row.type}</td>
              <td class="num">{formatNumber(row.hours, lang)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container page-section" aria-labelledby="past-heading">
    <header class="section-head">
      <h2 id="past-heading">{t(ui, 'past_courses')}</h2>
      <p class="section-note">{fmt(t(ui, 'courses_count'), { n: past.length })}</p>
    </header>
    <div class="entry-list">
      {groups.map((group) => (
        <div class="entry">
          <p class="entry-date">{shortAcademicYear(group.year)}</p>
          <ul class="course-list course-list-flat">
            {group.rows.map((row) => (
              <li>
                <span class="course-subject">{row.subject.trim()}</span>
                <span class="course-meta">{row.degree.trim()}, {fmt(t(ui, 'course_year'), { n: row.course })}. {row.entity}, {row.type}</span>
                <span class="course-hours">{fmt(t(ui, 'hours_short'), { n: formatNumber(row.hours, lang) })}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="container page-section" aria-labelledby="directed-heading">
    <header class="section-head">
      <h2 id="directed-heading">{t(ui, 'directed_projects')}</h2>
    </header>
    <div class="entry-list">
      {directed.map((row) => (
        <article class="entry">
          <p class="entry-date">{row.year}</p>
          <div class="entry-body">
            <p class="entry-kicker">{row.type}</p>
            <h3 class="entry-title">{row.title}</h3>
            <p class="entry-meta">{row.author}</p>
            <p class="entry-meta entry-meta-soft">
              {!isSoleSupervisor(row.supervisors) && <>{t(ui, 'co_supervision')}: <span set:html={authorsHtml(row.supervisors)} />. </>}
              {t(ui, 'grade_label')}: {row.qualification}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container page-section" aria-labelledby="innovation-heading">
    <header class="section-head">
      <h2 id="innovation-heading">{t(ui, 'innovation_projects')}</h2>
    </header>
    <div class="entry-list">
      {innovation.map((row) => (
        <article class="entry">
          <p class="entry-date">{shortAcademicYear(row.academic_year)}</p>
          <div class="entry-body">
            <h3 class="entry-title">{row.title}</h3>
            <dl class="meta-inline">
              <div><dt>{t(ui, 'entity')}</dt><dd>{row.entity}</dd></div>
              {row.reference && row.reference !== '-' && <div><dt>{t(ui, 'reference')}</dt><dd>{row.reference}</dd></div>}
              <div><dt>{t(ui, 'principal_researchers')}</dt><dd set:html={authorsHtml(row.ips)} /></div>
              {formatMoney(row.money, lang) && <div><dt>{t(ui, 'funding')}</dt><dd>{formatMoney(row.money, lang)}</dd></div>}
              <div><dt>{t(ui, 'role')}</dt><dd>{row.rol}</dd></div>
            </dl>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
