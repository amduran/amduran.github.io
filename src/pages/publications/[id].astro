---
import PublicationDetailView from '../../views/PublicationDetailView.astro';
import { collectionData } from '../../lib/content';

export async function getStaticPaths() {
  const rows = await collectionData('papers');
  return rows.map((row) => ({ params: { id: String(row.idx) }, props: { row } }));
}

const { row } = Astro.props;
---
<PublicationDetailView lang="es" row={row} kind="journal" />
