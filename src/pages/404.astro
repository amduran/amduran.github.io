---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUi } from '../lib/content';
import { route } from '../lib/routes';
import { t } from '../lib/utils';

const es = await getUi('es');
const en = await getUi('en');
---
<BaseLayout lang="es" routeKey="home" title={t(es, 'not_found_title')} noindex>
  <section class="container not-found">
    <p class="not-found-code" aria-hidden="true">404</p>
    <div class="not-found-copy">
      <h1 class="page-title">{t(es, 'not_found_title')}</h1>
      <p class="page-lead">{t(es, 'not_found_text')}</p>
      <p class="hero-actions">
        <a class="button button-primary" href={route('es', 'home')}>{t(es, 'back_home')}</a>
        <a class="button" href={route('es', 'publications')}>{t(es, 'publications')}</a>
      </p>
      <div lang="en" class="not-found-alt">
        <h2>{t(en, 'not_found_title')}</h2>
        <p>{t(en, 'not_found_text')} <a href={route('en', 'home')}>{t(en, 'back_home')}</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
